# /schedule is now a real booking page (schedule/index.html) with the
# calendar embedded — no more 301 to Google Calendar.

# ───────────────── Security headers ─────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  # Static site: inline scripts/styles are part of the pages, so
  # 'unsafe-inline' is required; everything else is locked down.
  #
  # Google Analytics needs two entries: googletagmanager.com in script-src to
  # load gtag.js, and the google-analytics.com hosts in connect-src for the
  # measurement beacons. Without the connect-src entry the tag loads and
  # silently sends nothing, which looks identical to a working install.
  # Note this policy also blocks the host's injected img1.wsimg.com tracker.
  # That is deliberate - it is not ours and is not disclosed in our privacy
  # policy, so it stays blocked.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://s3.tradingview.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; frame-src https://calendar.google.com https://*.google.com https://www.tradingview-widget.com https://s.tradingview.com https://www.youtube-nocookie.com https://www.youtube.com; connect-src 'self' https://api.gdeltproject.org https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

# ───────────────── Hide sensitive files ─────────────────
# Dotfiles (.htaccess, .git, .DS_Store…) and repo metadata return 404.
# .well-known stays reachable for certificate validation.
<IfModule mod_alias.c>
  RedirectMatch 404 ^/\.(?!well-known)
  RedirectMatch 404 ^/(package-lock\.json|README\.md)$
</IfModule>
# If the host ever enables directory listings, keep them empty.
<IfModule mod_autoindex.c>
  IndexIgnore *
</IfModule>

RewriteEngine On

# ─────────── Canonical host: force https + non-www (production only) ───────────
RewriteCond %{HTTP_HOST} ^www\.dosacc\.com$ [NC]
RewriteRule ^ https://dosacc.com%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^dosacc\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://dosacc.com%{REQUEST_URI} [R=301,L]

# ─────────── Canonical paths: one URL per page ───────────
# /index.html (root or subdir) -> directory URL
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[?\s] [NC]
RewriteRule ^(.*/)?index\.html$ /%1 [R=301,L]
# /page.html -> /page (the clean-URL rewrite below serves the file again)
RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[?\s] [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L]

# Clean contact URL: serve the homepage at /contact (the URL stays /contact in the bar);
# index.html scrolls to the contact section when loaded on this path.
# /contact/ redirects to /contact so the homepage's relative asset paths still resolve.
RewriteRule ^contact/$ /contact [R=301,L]
RewriteRule ^contact$ index.html [L]

# /404 must answer with a 404 status, not 200. Without this, the clean-URL rule
# below serves 404.html at /404 with a success status - a soft 404, which Search
# Console reports and which contradicts the page's own noindex. Apache serves
# ErrorDocument 404 /404.html internally, so the styled error page still renders.
# Verified against Apache 2.4.66: /404 and /404/ return 404, /404xyz is not
# matched, no redirect loop, all other routes unchanged.
RewriteRule ^404/?$ - [R=404,L]

# Clean URLs: serve /events as events.html, /leadership as leadership.html, etc.
# Only rewrites when the requested path isn't a real file/directory but a .html version exists.
# Uses DOCUMENT_ROOT+REQUEST_URI (not REQUEST_FILENAME, which collapses path-info:
# /events/nope would resolve to the real file /events and loop until a 500).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
RewriteRule ^(.+)$ $1.html [L]

# ───────────────── Custom error page ─────────────────
# ErrorDocument with a local path does nothing on this host. Verified
# 2026-09-05: /404.html is present, 0644, and returns 200 with the right page
# when requested directly, while every 404 still yields Apache's bare 13-byte
# "404 Not Found" - with this .htaccess demonstrably live, since edits to the
# rewrite rules above took effect in the same upload.
#
# A literal string is a different code path in Apache. If this renders, the
# directive is honoured and only the internal path lookup was failing; if it
# does not, ErrorDocument is disabled account-wide and only the host can
# change that. Either way visitors get something better than a reason phrase.
ErrorDocument 404 "<!doctype html><meta charset=utf-8><title>Page Not Found | DiligenceOS</title><meta name=robots content=noindex><style>body{font:16px/1.6 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,sans-serif;max-width:34rem;margin:16vh auto;padding:0 1.5rem;color:#0a2540}h1{font-size:1.5rem;margin:0 0 .5rem}a{color:#8a6a12}</style><h1>Page not found</h1><p>That page does not exist or has moved.</p><p><a href='/'>Go to the DiligenceOS homepage</a></p>"

# ───────────────── Compression ─────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# ───────────────── Browser caching ─────────────────
# NOTE: mod_expires is NOT loaded on this host - verified 2026-09-05, no
# Expires or Cache-Control header is emitted for any asset. The block below is
# therefore inert and kept only so the intent survives a host migration.
# Anything that must actually take effect goes in the mod_headers block that
# follows, since mod_headers IS active (it is what sets the CSP).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # analytics.js carries the consent gate. With no Cache-Control header the
  # browser falls back to heuristic freshness and can keep serving a stale copy
  # for hours, which is how a returning visitor ends up unable to withdraw
  # consent through a control the page is showing them. A privacy control that
  # ships but does not reach people is not shipped.
  #
  # no-cache means revalidate before use, not "do not store": the ETag turns
  # each check into a 304 of a few hundred bytes. For a 8 KB file that is the
  # right trade.
  <FilesMatch "analytics\.js$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
