{
  "name": "diligenceos-site",
  "private": true,
  "scripts": {
    "build:opp": "node opportunity/_src/build.mjs",
    "seo:crawl": "node seo/crawl.mjs",
    "seo:crawl:local": "node seo/crawl.mjs --local",
    "seo:schema": "node seo/validate-schema.mjs",
    "seo:logs": "node seo/parse-access-logs.mjs",
    "seo:diff": "node seo/crawl.mjs && node seo/report-diff.mjs",
    "seo:check": "node seo/check.mjs",
    "seo:hook": "sh seo/hooks/install.sh",
    "seo:report": "node seo/report-diff.mjs",
    "seo:brand": "node seo/gsc-brand-split.mjs",
    "seo:llms": "node seo/crawl.mjs --local --out seo/_tmp.csv && node seo/gen-llms-txt.mjs seo/_tmp.csv && rm -f seo/_tmp.csv"
  }
}
